{
  "manifest_version": 3,
  "name": "Scroll Region Capture",
  "version": "0.2.0",
  "description": "Capture a scrolling region of any page as one tall PNG. Drag a box, drag it down, get a screenshot.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Capture a scrolling region"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture a scrolling region"
    }
  }
}